{
  "name": "afterlife",
  "version": "0.1.0",
  "description": "Afterlife - proof-carrying agents for the post-code lifecycle on GitLab. Set up eight agents, watch every one, and take autonomy back with one click.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.17.0 || ^22.5.0 || >=24.0.0"
  },
  "bin": {
    "afterlife": "./cli/belay.mjs",
    "belay": "./cli/belay.mjs"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:inspect": "cross-env AFTERLIFE_INSPECTOR=1 next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test/targeted.mjs",
    "test:all": "node scripts/test/run.mjs",
    "test:fast": "node scripts/test/run.mjs --project unit",
    "test:guards": "node scripts/test/targeted.mjs --guards-only",
    "runner:prompt-drift": "node scripts/prompt-drift.mjs",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run check:structure && npm run test:all && npm run build",
    "doctor": "node cli/belay.mjs doctor",
    "demo:data": "node scripts/build-demo.mjs",
    "check:structure": "node scripts/check-structure.mjs src && node scripts/check-structure.mjs engine && node scripts/check-structure.mjs runner && node scripts/check-structure.mjs cli && node scripts/check-structure.mjs scripts",
    "engine": "tsx engine/cli.ts",
    "onboard:ab": "tsx --tsconfig tsconfig.json src/server/discover/ab/abCli.ts",
    "runner": "node cli/belay.mjs run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
