{
  "$comment": "Posted in the upgrade MR description in a belay-claims block (class patch-bump). Each changelog claim quotes the upstream text and links it; upstream text is untrusted.",
  "type": "object",
  "required": [
    "schema",
    "task",
    "class",
    "package",
    "from",
    "to",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "belay.gardener/1"
    },
    "task": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "class": {
      "const": "patch-bump"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "quote",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "budget_pct": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
