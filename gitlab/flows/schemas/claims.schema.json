{
  "$comment": "Patcher claims in the MR description (a belay-claims fenced block). Claims are the agent statements; the engine re-derives them. The agent never writes a verdict.",
  "type": "object",
  "required": [
    "schema",
    "task",
    "class",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "belay.claims/1"
    },
    "task": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "vector"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "vector": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "path",
        "command",
        "markers"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "quote": {
            "type": "object",
            "required": [
              "file",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
