{
  "$comment": "Posted by the QA flow in a belay-qa block. Steps use a closed set of actions so a scripted browser can replay them (proof class repro).",
  "type": "object",
  "required": [
    "schema",
    "target_url",
    "bugs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "belay.qa/1"
    },
    "target_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "steps",
          "expected",
          "observed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "action": {
                  "enum": [
                    "goto",
                    "click",
                    "fill",
                    "expect_text"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "expected": {
            "type": "string",
            "maxLength": 400
          },
          "observed": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  }
}
